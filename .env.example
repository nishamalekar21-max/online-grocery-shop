# eSewa Merchant Credentials (.env file format)
# Copy this as .env and fill in your actual credentials

# Your eSewa merchant code
# For testing: EPAYTEST
# For production: Get from https://dashboard.esewa.com.np/
ESEWA_MERCHANT_CODE=EPAYTEST

# Your eSewa secret key
# For testing: test_secret_key
# For production: Get from https://dashboard.esewa.com.np/
ESEWA_SECRET_KEY=test_secret_key

# eSewa API URL
# Testing: https://rc-epay.esewa.com.np/api/epay/main/v2/payment
# Production: https://epay.esewa.com.np/api/epay/main/v2/payment
ESEWA_BASE_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/payment

# Your application's base URL (important for payment callbacks)
# For localhost: http://localhost/online-grocery-shop
# For production: https://yourdomain.com/online-grocery-shop
# NOTE: eSewa needs a public URL for callbacks. Use ngrok for localhost.
APP_BASE_URL=http://localhost/online-grocery-shop
